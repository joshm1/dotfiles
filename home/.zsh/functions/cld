# Launch Claude Code with permission prompts skipped. Inside a cmux workspace,
# use the cmux-integrated team launcher so the session is tracked as a cmux
# agent; otherwise run plain `claude`. Extra args pass through either way.
# claude-teams presents itself as tmux, so Claude Code would otherwise print
# raw URLs instead of clickable OSC 8 links.
if [[ -n "$CMUX_WORKSPACE_ID" ]] && command -v cmux &>/dev/null; then
  FORCE_HYPERLINK=1 cmux claude-teams --dangerously-skip-permissions "$@"
else
  claude --dangerously-skip-permissions "$@"
fi
